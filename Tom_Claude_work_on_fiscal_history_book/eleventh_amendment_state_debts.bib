@misc{chisholm1793,
  author       = {{Supreme Court of the United States}},
  title        = {Chisholm v. Georgia, 2 U.S. (2 Dall.) 419},
  year         = {1793},
  note         = {[PRIMARY] Decided 18 February 1793. Suit by a South Carolina executor against Georgia for a Revolutionary War supply debt; held (4--1, Iredell dissenting) that a state may be sued in federal court by a citizen of another state}
}

