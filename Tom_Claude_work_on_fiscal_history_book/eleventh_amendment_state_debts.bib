}

@misc{hans1890,
  author       = {{Supreme Court of the United States}},
  title        = {Hans v. Louisiana, 134 U.S. 1},
  year         = {1890},
  note         = {[PRIMARY] Decided 3 March 1890 (Bradley, J.). Arising from Louisiana's repudiation of interest on its consolidated bonds, held that a state may not be sued in federal court even by its own citizens without consent}
}

@misc{monaco1934,
