% ---------- Primary: statutes, treaties, cases ----------

@misc{hening1777sequestration,
  author       = {Hening, William Waller},
  title        = {An Act for Sequestering British Property, Enabling Those Indebted to British Subjects to Pay Off Such Debts, and Directing the Proceedings in Suits Where Such Subjects Are Parties (October 1777, ch.~9)},
  howpublished = {The Statutes at Large; Being a Collection of All the Laws of Virginia, vol.~9, pp.~377--380},
  address      = {Richmond},
  year         = {1821},
  note         = {[PRIMARY] Enacted Oct.\ 1777 session (into Jan.\ 1778); drafted by Jefferson. The loan-office discharge is in the third section, quoted verbatim in \emph{Ware v. Hylton}}
}

@misc{treatyparis1783,
  author       = {{United States and Great Britain}},
  title        = {The Definitive Treaty of Peace (Treaty of Paris)},
  howpublished = {Signed at Paris, 3 September 1783. The Avalon Project, Lillian Goldman Law Library, Yale Law School},
  year         = {1783},
  note         = {[PRIMARY] Art.~4 (creditors to meet ``no lawful impediment'' to recovery of full sterling value); Art.~5 (Congress to ``earnestly recommend'' restitution); Art.~6 (no future confiscations); Art.~7 (British withdrawal ``without\,\ldots\ carrying away any Negroes'')},
  url          = {https://avalon.law.yale.edu/18th_century/paris.asp}
}

@misc{jaytreaty1794,
  author       = {{United States and Great Britain}},
  title        = {Treaty of Amity, Commerce and Navigation (Jay Treaty)},
  howpublished = {Signed at London, 19 November 1794. The Avalon Project, Yale Law School},
  year         = {1794},
  note         = {[PRIMARY] Art.~6 establishes a five-member debt-claims commission and pledges ``full and complete Compensation'' for pre-war British debts unrecoverable through lawful impediments; excludes losses from debtor insolvency},
  url          = {https://avalon.law.yale.edu/18th_century/jay.asp}
}

@misc{convention1802,
  author       = {{United States and Great Britain}},
  title        = {Convention Regarding Articles 6 and 7 of the Jay Treaty and Article 4 of the Definitive Treaty of Peace},
  howpublished = {Signed at London, 8 January 1802 (Rufus King and Lord Hawkesbury). The Avalon Project, Yale Law School},
  year         = {1802},
  note         = {[PRIMARY] United States pays \pounds600{,}000 sterling in three annual installments of \pounds200{,}000, ``in Satisfaction and Discharge'' of Jay Treaty Art.~6, which ``is hereby declared to be cancelled and annulled''},
  url          = {https://avalon.law.yale.edu/19th_century/jayconv.asp}
}

@misc{warevhylton1796,
  author       = {{Supreme Court of the United States}},
  title        = {Ware v. Hylton, 3 U.S. (3 Dall.) 199},
  year         = {1796},
  note         = {[PRIMARY] Held that Art.~4 of the 1783 treaty, as supreme law, overrode Virginia's sequestration statute; loan-office payment did not discharge the debt. Seriatim opinions: Chase (leading), Paterson, Wilson, Cushing, Iredell. John Marshall argued for the debtors}
}

@misc{jonesvwalker1791,
  author       = {{U.S. Circuit Court, District of Virginia}},
  title        = {Jones v. Walker, 13 F.\ Cas.\ 1059 (No.\ 7,507)},
  year         = {1791},
  note         = {[PRIMARY] Circuit-court precursor to \emph{Ware}; British-debt case argued at Richmond before Justice Iredell, Patrick Henry for the debtor; left undecided}
}

@misc{georgiavbrailsford1794,
  author       = {{Supreme Court of the United States}},
  title        = {Georgia v. Brailsford, 3 U.S. (3 Dall.) 1},
  year         = {1794},
  note         = {[PRIMARY] Sequestered British debt; the only jury trial in Supreme Court history. Sequestration suspended but did not extinguish the creditor's right. See also 2 Dall.\ 402 (1792) and 2 Dall.\ 415 (1793)}
}

@misc{jayreport1786,
  author       = {Jay, John},
  title        = {Report of the Secretary for Foreign Affairs on the Infractions of the Treaty of Peace},
  howpublished = {Report to the Continental Congress, 13 October 1786},
  year         = {1786},
  note         = {[PRIMARY] Concluded that the American states had first violated the treaty; recommended the states repeal contrary laws and declare treaties part of the law of the land}
}

@misc{congress1787resolve,
  author       = {{United States in Congress Assembled}},
  title        = {Resolutions Recommending Repeal of State Laws Repugnant to the Treaty of Peace},
  howpublished = {Resolution and circular letter to the states, 21 March 1787},
  year         = {1787},
  note         = {[PRIMARY] Declared treaties part of the law of the land, binding on the states; urged repeal of all repugnant acts}
}

@misc{madison1784resolutions,
